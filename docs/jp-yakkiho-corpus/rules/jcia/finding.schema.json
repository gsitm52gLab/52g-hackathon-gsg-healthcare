{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JCIA pre-screening finding",
  "type": "object",
  "additionalProperties": false,
  "required": ["finding_id", "rule_id", "ai_status", "human_review_status", "conclusion", "matched_text", "review_reason", "legal_basis", "supporting_guidance", "required_evidence", "exact_basis_unresolved", "expert_escalation", "disclaimer"],
  "properties": {
    "finding_id": {"type": "string", "minLength": 1},
    "rule_id": {"type": "string", "pattern": "^JCIA-R-[0-9]{3}$"},
    "ai_status": {"enum": ["검토 후보", "근거 확인 필요"]},
    "human_review_status": {"enum": ["미검토", "담당자 검토 완료"]},
    "conclusion": {"const": "관련 조항과 충돌 가능성이 있는 문제 후보"},
    "matched_text": {"type": "string"},
    "review_reason": {"type": "string", "minLength": 1},
    "legal_basis": {"type": "array", "items": {"$ref": "#/$defs/basis"}},
    "supporting_guidance": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/basis"}},
    "required_evidence": {"type": "array", "items": {"type": "string"}},
    "exact_basis_unresolved": {"type": "boolean"},
    "expert_escalation": {"type": "boolean"},
    "disclaimer": {"const": "AI 결과는 JCIA 업계 자율기준에 따른 사전검토 보조이며 법률판단이나 최종 승인 결과가 아닙니다."}
  },
  "$defs": {
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "official_title", "authority_level", "locator", "source_anchor", "official_url", "effective_or_version_date", "binding_note", "exact_basis_unresolved"],
      "properties": {
        "source_id": {"type": "string", "minLength": 3},
        "official_title": {"type": "string", "minLength": 2},
        "authority_level": {"enum": ["statute", "mhlw_notice", "industry_guideline"]},
        "locator": {"type": ["string", "null"]},
        "source_anchor": {"type": ["string", "null"]},
        "official_url": {"type": "string", "pattern": "^https://"},
        "effective_or_version_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "binding_note": {"type": "string", "minLength": 5},
        "exact_basis_unresolved": {"type": "boolean"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"exact_basis_unresolved": {"const": true}}, "required": ["exact_basis_unresolved"]},
      "then": {"properties": {"ai_status": {"const": "근거 확인 필요"}, "expert_escalation": {"const": true}}}
    }
  ]
}
