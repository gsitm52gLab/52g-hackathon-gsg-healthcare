{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JCIA practical review rule",
  "type": "object",
  "additionalProperties": false,
  "required": ["rule_id", "title_ko", "product_types", "channels", "risk_type", "trigger_concepts", "review_questions", "allowed_context", "risky_context", "required_evidence", "escalation", "source_document_id", "source_locator", "official_url", "authority", "version_status", "updated_at", "legal_basis", "supporting_guidance", "exact_basis_unresolved", "output_policy"],
  "properties": {
    "rule_id": {"type": "string", "pattern": "^JCIA-R-[0-9]{3}$"},
    "title_ko": {"type": "string", "minLength": 2},
    "product_types": {"type": "array", "minItems": 1, "items": {"enum": ["cosmetic", "quasi_drug", "medicated_cosmetic", "unknown"]}},
    "channels": {"type": "array", "minItems": 1, "items": {"enum": ["all", "web", "social", "marketplace", "email", "video", "tv", "print", "package", "landing_page"]}},
    "risk_type": {"type": "string", "minLength": 2},
    "trigger_concepts": {"type": "array", "minItems": 1, "items": {"type": "string", "maxLength": 80}},
    "review_questions": {"type": "array", "minItems": 1, "items": {"type": "string", "maxLength": 220}},
    "allowed_context": {"type": "array", "minItems": 1, "items": {"type": "string", "maxLength": 260}},
    "risky_context": {"type": "array", "minItems": 1, "items": {"type": "string", "maxLength": 260}},
    "required_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "maxLength": 180}},
    "escalation": {"type": "string", "minLength": 5, "maxLength": 300},
    "source_document_id": {"enum": ["JP-JCIA-AD-2026-ALPHA", "JP-JCIA-AD-2020-2ND", "JP-JCIA-INET-2017"]},
    "source_locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section_id", "printed_pages", "pdf_pages"],
      "properties": {
        "section_id": {"type": "string", "minLength": 1},
        "printed_pages": {"type": "string", "pattern": "^[0-9]+(?:-[0-9]+)?$"},
        "pdf_pages": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}}
      }
    },
    "official_url": {"type": "string", "pattern": "^https://www\\.jcia\\.org/"},
    "authority": {"const": "industry_self_regulation"},
    "version_status": {"enum": ["alpha", "current", "previous_final"]},
    "updated_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "legal_basis": {"type": "array", "items": {"$ref": "#/$defs/basis"}},
    "supporting_guidance": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/basis"}},
    "exact_basis_unresolved": {"type": "boolean"},
    "output_policy": {"const": "pre_screening_only_no_legality_or_approval_conclusion"}
  },
  "$defs": {
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "official_title", "authority_level", "locator", "source_anchor", "official_url", "effective_or_version_date", "binding_note", "exact_basis_unresolved"],
      "properties": {
        "source_id": {"type": "string", "minLength": 3},
        "official_title": {"type": "string", "minLength": 2},
        "authority_level": {"enum": ["statute", "mhlw_notice", "industry_guideline"]},
        "locator": {"type": ["string", "null"]},
        "source_anchor": {"type": ["string", "null"]},
        "official_url": {"type": "string", "pattern": "^https://"},
        "effective_or_version_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "binding_note": {"type": "string", "minLength": 5},
        "exact_basis_unresolved": {"type": "boolean"}
      }
    }
  }
}
